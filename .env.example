# Copy with: cp .env.example .env && chmod 600 .env
# Generate a local DB password: python3 -c "import secrets; print(secrets.token_urlsafe(18))"
# Never commit real secrets.

# Explicit runtime safety profile: development|test|pilot|production.
# pilot/production require a non-empty allowlist, real bot token, strong
# webhook secret, positive quotas and HTTPS provider endpoints.
APP_ENV=development

# PostgreSQL. POSTGRES_PORT is the host port docker-compose publishes
# (bound to 127.0.0.1 only); keep it in sync with DATABASE_URL. Change both
# when local 5432 is taken. make test-integration / TEST_DATABASE_URL uses
# the isolated zl_expense_test database (see scripts/ensure-db.sh).
# Changing POSTGRES_PASSWORD requires recreating the volume:
#   docker compose down -v && docker compose up -d
POSTGRES_PORT=5432
POSTGRES_PASSWORD=change-me-local
DATABASE_URL=postgres://postgres:change-me-local@localhost:5432/zl_expense?sslmode=disable
# TEST_DATABASE_URL=postgres://postgres:change-me-local@localhost:5432/zl_expense_test?sslmode=disable

# Zalo Bot (leave empty to use the local "log" messaging provider, which
# prints outbound messages instead of calling the Zalo Bot API)
ZALO_BOT_TOKEN=
ZALO_WEBHOOK_SECRET=dev-secret-change-me
ZALO_API_BASE=https://bot-api.zaloplatforms.com

# HTTP API
LISTEN_ADDR=127.0.0.1:8080

# Pilot allowlist: comma-separated Zalo sender IDs. Empty = allow everyone
# (development only; set this before inviting pilot users).
PILOT_ALLOWLIST=

# Cost controls / kill switches
# External work is fail-closed by default. `make simulate` overrides these
# two flags for its local-only deterministic demo.
EXTRACTION_ENABLED=false
OUTBOUND_ENABLED=false
MONTHLY_OCR_PAGE_LIMIT=80
PER_USER_DAILY_RECEIPT_LIMIT=20
ZALO_MONTHLY_MESSAGE_LIMIT=3000

# Object store: compose MinIO (`make up`) is the default S3 stand-in.
# OBJECTSTORE=local writes under DATA_DIR instead. Receipt image bytes are
# deleted after ORIGINAL_RETENTION_DAYS (hourly sweeper; ledger rows stay).
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY must match MINIO_ROOT_*.
# Cloudflare R2 later: S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# and S3_REGION=auto.
DATA_DIR=./data
ORIGINAL_RETENTION_DAYS=1
OBJECTSTORE=s3
S3_BUCKET=zl-expense-receipts
S3_PREFIX=
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# EXTRACTOR=mock|gemini|textract. production forbids mock.
# gemini uses Google AI Studio (GEMINI_API_KEY). Unpaid keys may be reviewed;
# do not send personal receipts unless the project has billing and consent.
EXTRACTOR=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_BASE=https://generativelanguage.googleapis.com

# Workers
RECEIPT_WORKER_CONCURRENCY=4
NOTIFICATION_WORKER_CONCURRENCY=2
QUEUE_POLL_INTERVAL=300ms
SUMMARY_SCHEDULE_POLL_INTERVAL=30s

# Logging: debug|info|warn|error
LOG_LEVEL=info
