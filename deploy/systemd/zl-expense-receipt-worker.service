[Unit]
Description=zl-expense receipt worker (OCR pipeline + retention sweep)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=@ROOT@
ExecStart=@ROOT@/scripts/run-with-env.sh @ROOT@/bin/receipt-worker
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
