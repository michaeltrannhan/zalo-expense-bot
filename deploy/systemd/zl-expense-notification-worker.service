[Unit]
Description=zl-expense notification worker (Zalo outbound + scheduled summaries)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=@ROOT@
EnvironmentFile=@ROOT@/.env
ExecStart=@ROOT@/bin/notification-worker
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
